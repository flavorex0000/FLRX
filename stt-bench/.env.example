# 이 파일을 .env 로 복사해 키를 채우세요. .env 는 커밋되지 않습니다.
# 키가 없는 서비스는 실행 시 자동으로 건너뜁니다.

# --- 먼저 비교할 8개 ---
SONIOX_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# MAI-Transcribe-2 와 Azure LLM Speech 가 같은 리소스를 씁니다.
# 리전: centralindia, eastus, northeurope, southeastasia, westus, westus2 중 하나 (koreacentral 불가)
AZURE_SPEECH_ENDPOINT=https://<리소스이름>.cognitiveservices.azure.com
AZURE_SPEECH_KEY=
DEEPGRAM_API_KEY=
# 싱가포르(국제) 리전 키
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com

# --- 추가 3개 ---
XAI_API_KEY=
# CLOVA Speech 도메인 > 설정 > 연동 정보 의 Invoke URL 과 Secret Key
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=
# 다글로 API 콘솔 > 토큰
DAGLO_API_TOKEN=
